# Dibaca Vite saat `npm run build`. TIDAK berisi rahasia (variabel VITE_* tampil di browser).
# "/api" relatif = satu origin dengan halaman (FastAPI menyajikan frontend + API sekaligus).
VITE_API_BASE_URL=/api
VITE_USE_LIVE_MONITORING=true
# Halaman katalog/dokumen/profil tetap memakai data contoh; empat halaman monitoring memakai backend.
VITE_USE_MOCK_DATA=true
# VITE_TELEGRAM_BOT_URL=
# VITE_TELEGRAM_BOT_USERNAME=@FASCA_Bot
