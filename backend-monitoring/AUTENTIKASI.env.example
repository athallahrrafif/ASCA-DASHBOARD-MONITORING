# TAMBAHKAN ke backend-monitoring/.env di laptop pribadi (BUKAN .env frontend)
# HANYA untuk pengujian lokal; jangan gunakan admin/admin di internet.
ASCA_ADMIN_USERNAME=admin
ASCA_ADMIN_PASSWORD=admin
ASCA_COOKIE_SECURE=false
# Jika suatu saat memakai HTTPS: ASCA_COOKIE_SECURE=true dan password kuat.
