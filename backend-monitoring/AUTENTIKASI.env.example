# TAMBAHKAN ke backend-monitoring/.env (BUKAN .env frontend). Jangan pernah di-commit.
# Nama variabel: FASCA_* (ASCA_* lama tetap diterima oleh backend).

# --- Lokal (http://localhost) ---
FASCA_ADMIN_USERNAME=admin
FASCA_ADMIN_PASSWORD=ganti-dengan-password-lokal
FASCA_COOKIE_SECURE=false

# --- Produksi / internet (HTTPS di Render) ---
# FASCA_COOKIE_SECURE=true  -> server menolak start bila password kosong / < 10 karakter / lemah.
# FASCA_ADMIN_PASSWORD=<password panjang & acak>
#
# Opsional: FASCA_ENABLE_DOCS=true menyalakan /docs (hanya untuk lokal).
