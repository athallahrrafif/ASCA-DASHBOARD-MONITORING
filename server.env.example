# Salin ke file bernama ".env" DI SERVER (cp server.env.example .env), lalu isi.
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Catatan: jika nilai mengandung tanda $, tulis $$ (aturan Docker Compose).

# Domain yang sudah diarahkan (DNS A record) ke IP VPS
SITE_DOMAIN=dashboard.namadomain.my.id

# Login admin dashboard. Server menolak start jika kosong / kurang dari 10 karakter / lemah.
FASCA_ADMIN_USERNAME=admin
FASCA_ADMIN_PASSWORD=GANTI-DENGAN-PASSWORD-PANJANG-DAN-ACAK
FASCA_COOKIE_SECURE=true

# --- TAHAP 1: mode simulasi (uji dulu) ---
DATABASE_URL=sqlite:///./demo.sqlite3
MONITOR_TABLE=chatbot_logs

# --- TAHAP 2: data asli (ganti dua baris di atas setelah login berhasil) ---
# Supabase -> Connect -> Session pooler, akun READ-ONLY, password di-URL-encode:
# DATABASE_URL=postgresql+psycopg://ROLE.PROJECT_REF:PASSWORD@HOST-POOLER:5432/postgres
# MONITOR_TABLE=telegram_chat_logs
